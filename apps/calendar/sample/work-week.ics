BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ZengBot//ZengCalendar sample//EN
CALSCALE:GREGORIAN
X-WR-CALNAME:Sample: Work week
X-APPLE-CALENDAR-COLOR:#0a84ff
BEGIN:VEVENT
UID:sample-standup@zengcalendar
DTSTAMP:20261001T000000Z
DTSTART;TZID=America/New_York:20261026T093000
DTEND;TZID=America/New_York:20261026T094500
RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR
EXDATE;TZID=America/New_York:20261127T093000
SUMMARY:Team standup
LOCATION:Room 4
CATEGORIES:Meeting
ATTENDEE;CN=Sam Rivera:mailto:sam@example.com
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Team standup
TRIGGER:-PT5M
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:sample-review@zengcalendar
DTSTAMP:20261001T000000Z
DTSTART;TZID=America/New_York:20261102T100000
